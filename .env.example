# Figma Personal Access Token
# 获取方式: Figma -> Settings -> Personal access tokens -> Generate new token
FIGMA_ACCESS_TOKEN=figd_your_token_here

# AI 视觉分析配置 (可选, 用于 AI 分析模式)
# 支持 OpenAI 兼容接口 (OpenAI, DeepSeek) 和 Anthropic Claude
# 选择 Claude 时: AI_API_BASE=https://api.anthropic.com, AI_MODEL=claude-sonnet-4-20250514
# 选择 OpenAI 时: AI_API_BASE=https://api.openai.com/v1, AI_MODEL=gpt-4o
# 选择 DeepSeek 时: AI_API_BASE=https://api.deepseek.com/v1, AI_MODEL=deepseek-chat
AI_API_KEY=sk-your_key_here
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o
# AI_PROVIDER 可选: openai | claude (不填则根据 MODEL 自动推断)
# AI_PROVIDER=openai
