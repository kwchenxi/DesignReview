#!/usr/bin/env node
/**
 * 设计实现对比审查脚本
 * 用法: ./design-implementation-review <设计稿路径> <实现页面路径>
 * 示例: ./design-implementation-review "/tmp/设计稿.png" "/tmp/实现页面.png"
 */

const fs = require('fs')
const path = require('path')

// 动态加载设计对比函数
function loadDesignReview() {
  // 尝试加载编译后的版本
  try {
    return require('./dist/index').designReview
  } catch (err) {
    // 如果未编译，使用 ts-node
    console.log('📦 使用 ts-node 运行 TypeScript 版本...')
    require('ts-node/register')
    return require('./src/index').designReview
  }
}

const designReview = loadDesignReview()

async function main() {
  // 如果没有参数，尝试使用用户提供的默认路径
  let figmaScreenshot, pageScreenshot
  
  if (process.argv.length >= 4) {
    // 从命令行参数获取
    pageScreenshot = process.argv[2]
    figmaScreenshot = process.argv[3]
  } else {
    // 使用用户提供的默认路径
    figmaScreenshot = '/var/folders/mp/f30cybhj6vn2llw8vxbsl7nc0000gn/T/会议首页设计稿.png'
    pageScreenshot = '/var/folders/mp/f30cybhj6vn2llw8vxbsl7nc0000gn/T/会议首页.png'
  }
  
  console.log('🚀 设计实现对比审查\n')
  console.log('📁 检查文件...')
  
  // 检查文件是否存在
  if (!fs.existsSync(figmaScreenshot)) {
    console.error(`❌ 设计稿文件不存在: ${figmaScreenshot}`)
    console.log('请提供正确的设计稿截图路径')
    process.exit(1)
  }
  if (!fs.existsSync(pageScreenshot)) {
    console.error(`❌ 页面截图文件不存在: ${pageScreenshot}`)
    console.log('请提供正确的页面截图路径')
    process.exit(1)
  }
  
  console.log(`✅ 设计稿: ${path.basename(figmaScreenshot)}`)
  console.log(`✅ 实现页面: ${path.basename(pageScreenshot)}\n`)
  
  // 创建输出目录
  const outputDir = './design-review-output'
  if (!fs.existsSync(outputDir)) {
    fs.mkdirSync(outputDir, { recursive: true })
  }
  
  try {
    console.log('🔄 正在对比设计稿与实现页面...')
    
    const report = await designReview({
      pageScreenshot,
      figmaScreenshot,
      options: {
        output: {
          dir: outputDir,
          formats: ['html', 'markdown'],
          screenshotScale: 2,
        },
      },
    })
    
    console.log('\n✅ 设计还原度检查完成!')
    console.log(`📊 总体还原度评分: ${report.meta.overallScore}/100`)
    console.log(`📋 问题总数: ${report.meta.totalIssues}`)
    console.log(`  🔴 严重: ${report.meta.criticalCount}`)
    console.log(`  🟠 主要: ${report.meta.majorCount}`)
    console.log(`  🟡 次要: ${report.meta.minorCount}`)
    console.log(`  🟢 建议: ${report.meta.suggestionCount}\n`)
    
    console.log('📁 生成的报告文件:')
    report.outputFiles.forEach(file => {
      console.log(`  - ${file}`)
    })
    
    const htmlReport = path.join(outputDir, 'design-review-report.html')
    if (fs.existsSync(htmlReport)) {
      console.log(`\n🌐 HTML 报告: file://${path.resolve(htmlReport)}`)
      console.log('   📌 复制以上链接到浏览器中打开查看详细报告')
    }
    
  } catch (error) {
    console.error('\n❌ 执行失败:', error.message)
    console.log('\n🔧 尝试编译项目...')
    
    // 尝试构建项目
    try {
      const { execSync } = require('child_process')
      console.log('运行 npm run build...')
      execSync('npm run build', { stdio: 'inherit' })
      
      // 重新加载编译后的模块
      delete require.cache[require.resolve('./dist/index')]
      const { designReview: designReview2 } = require('./dist/index')
      
      console.log('🔄 重新执行设计对比...')
      const report = await designReview2({
        pageScreenshot,
        figmaScreenshot,
        options: {
          output: {
            dir: outputDir,
            formats: ['html', 'markdown'],
            screenshotScale: 2,
          },
        },
      })
      
      console.log('\n✅ 设计还原度检查完成!')
      console.log(`📊 总体还原度评分: ${report.meta.overallScore}/100`)
      console.log(`📋 问题总数: ${report.meta.totalIssues}`)
      
      const htmlReport = path.join(outputDir, 'design-review-report.html')
      if (fs.existsSync(htmlReport)) {
        console.log(`\n🌐 HTML 报告: file://${path.resolve(htmlReport)}`)
      }
      
    } catch (buildError) {
      console.error('❌ 构建失败:', buildError.message)
      console.log('\n💡 替代方案:')
      console.log('1. 启动 Web 界面: npm run web')
      console.log('2. 访问 http://localhost:3456')
      console.log('3. 上传两张截图进行对比')
      process.exit(1)
    }
  }
}

// 如果是直接运行此脚本
if (require.main === module) {
  main().catch(err => {
    console.error('未处理的错误:', err)
    process.exit(1)
  })
}

module.exports = { main }