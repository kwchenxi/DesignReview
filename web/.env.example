# ========== 公开版配置示例 ==========
# 注意：本工具支持运行时配置，以下环境变量为默认值，可被用户配置覆盖

# Figma Access Token (可选)
# 用户可在 Web 界面配置，此为默认值
FIGMA_TOKEN=

# AI API Key (可选，支持算法模式，AI 为增强功能)
# 用户可在 Web 界面配置，此为默认值
AI_API_KEY=

# AI 模型选择 (可选)
# 选项: claude, gpt4, gpt3.5
AI_MODEL=claude

# 服务器配置
PORT=3457
HOST=0.0.0.0

# 日志级别
LOG_LEVEL=info
